{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil e credenciais de acesso do usuário no Compras365",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "buyer", "approver", "collaborator", "stock_manager"] },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "department": { "type": "string", "maxLength": 80 },
        "approvalLimit": { "type": "number" },
        "phone": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "email", "role", "status", "createdAt"]
    },
    "PurchaseRequest": {
      "title": "PurchaseRequest",
      "description": "Solicitação de compra gerada por colaborador ou almoxarifado",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 32 },
        "requesterId": { "type": "string", "maxLength": 128 },
        "requesterName": { "type": "string", "maxLength": 120 },
        "requesterEmail": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 80 },
        "justification": { "type": "string", "maxLength": 500 },
        "urgency": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "status": { "type": "string", "enum": ["draft", "pending_quote", "quoting", "pending_approval", "approved", "rejected", "ordered", "completed", "cancelled"] },
        "estimatedTotal": { "type": "number" },
        "items": { "type": "array" },
        "quoteId": { "type": "string", "maxLength": 64 },
        "orderId": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["code", "requesterId", "status", "createdAt"]
    },
    "Quote": {
      "title": "Quote",
      "description": "Cotação de preços comparativa entre fornecedores",
      "type": "object",
      "properties": {
        "quoteId": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 32 },
        "requestId": { "type": "string", "maxLength": 64 },
        "requestCode": { "type": "string", "maxLength": 32 },
        "buyerId": { "type": "string", "maxLength": 128 },
        "buyerName": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["draft", "in_progress", "completed", "approved", "rejected"] },
        "suppliersQuotes": { "type": "array" },
        "selectedSupplierId": { "type": "string", "maxLength": 64 },
        "totalAmount": { "type": "number" },
        "savingAmount": { "type": "number" },
        "savingPercent": { "type": "number" },
        "awardedMode": { "type": "string", "enum": ["total", "by_item"] },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["quoteId", "requestId", "status", "createdAt"]
    },
    "PurchaseOrder": {
      "title": "PurchaseOrder",
      "description": "Pedido de Compra oficial enviado ao fornecedor",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 64 },
        "orderNumber": { "type": "string", "maxLength": 32 },
        "quoteId": { "type": "string", "maxLength": 64 },
        "requestId": { "type": "string", "maxLength": 64 },
        "supplierId": { "type": "string", "maxLength": 64 },
        "supplierName": { "type": "string", "maxLength": 120 },
        "supplierCnpj": { "type": "string", "maxLength": 30 },
        "supplierEmail": { "type": "string", "maxLength": 128 },
        "supplierPhone": { "type": "string", "maxLength": 30 },
        "buyerId": { "type": "string", "maxLength": 128 },
        "approverId": { "type": "string", "maxLength": 128 },
        "approverName": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["draft", "issued", "sent", "confirmed", "partial_received", "received", "cancelled"] },
        "totalAmount": { "type": "number" },
        "paymentTerms": { "type": "string", "maxLength": 100 },
        "deliveryDeadline": { "type": "string" },
        "deliveryAddress": { "type": "string", "maxLength": 200 },
        "invoiceNumber": { "type": "string", "maxLength": 50 },
        "invoiceKey": { "type": "string", "maxLength": 60 },
        "items": { "type": "array" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["orderId", "orderNumber", "supplierId", "status", "totalAmount", "createdAt"]
    },
    "StockItem": {
      "title": "StockItem",
      "description": "Item em almoxarifado com controle de saldo e ponto de pedido",
      "type": "object",
      "properties": {
        "itemId": { "type": "string", "maxLength": 64 },
        "sku": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 60 },
        "unit": { "type": "string", "maxLength": 10 },
        "currentStock": { "type": "number" },
        "minStock": { "type": "number" },
        "maxStock": { "type": "number" },
        "avgCost": { "type": "number" },
        "location": { "type": "string", "maxLength": 60 },
        "lastRestockDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["itemId", "sku", "name", "unit", "currentStock", "minStock"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Registro transacional de entrada ou saída do almoxarifado",
      "type": "object",
      "properties": {
        "movementId": { "type": "string", "maxLength": 64 },
        "itemId": { "type": "string", "maxLength": 64 },
        "itemName": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["in", "out", "adjustment"] },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "referenceType": { "type": "string", "enum": ["purchase_order", "requisition", "inventory_count", "donation"] },
        "referenceId": { "type": "string", "maxLength": 64 },
        "invoiceNumber": { "type": "string", "maxLength": 50 },
        "performedBy": { "type": "string", "maxLength": 128 },
        "performedByName": { "type": "string", "maxLength": 120 },
        "department": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string" }
      },
      "required": ["movementId", "itemId", "type", "quantity", "performedBy", "createdAt"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Cadastro de fornecedores homologados ou em cotação",
      "type": "object",
      "properties": {
        "supplierId": { "type": "string", "maxLength": 64 },
        "corporateName": { "type": "string", "maxLength": 150 },
        "tradeName": { "type": "string", "maxLength": 150 },
        "cnpj": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 30 },
        "contactPerson": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 60 },
        "city": { "type": "string", "maxLength": 60 },
        "state": { "type": "string", "maxLength": 2 },
        "rating": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["supplierId", "tradeName", "cnpj", "email"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Trilha imutável de eventos de auditoria",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "userRole": { "type": "string", "maxLength": 30 },
        "action": { "type": "string", "maxLength": 60 },
        "entity": { "type": "string", "maxLength": 50 },
        "entityId": { "type": "string", "maxLength": 64 },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["logId", "userId", "userEmail", "action", "entity", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Perfis de usuários, controle de papéis e status de aprovação"
    },
    "/requests/{requestId}": {
      "schema": "PurchaseRequest",
      "description": "Solicitações de compra individuais por documento"
    },
    "/quotes/{quoteId}": {
      "schema": "Quote",
      "description": "Cotações comparativas de preços"
    },
    "/orders/{orderId}": {
      "schema": "PurchaseOrder",
      "description": "Pedidos de compra numerados e rastreáveis"
    },
    "/stock/{itemId}": {
      "schema": "StockItem",
      "description": "Itens de almoxarifado com estoque mínimo"
    },
    "/stock_movements/{movementId}": {
      "schema": "StockMovement",
      "description": "Movimentações de entrada e saída no estoque"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Fornecedores cadastrados"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Logs de auditoria append-only imutáveis"
    }
  }
}
